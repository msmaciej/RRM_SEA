; SimpleEA Trend Optimized Preset v1.0
; Philosophy: "Sniper Mode" - Aggressive Trend Following with strict Risk Mgmt
; Experts: Industrial Bank Trader & Profitable Trader Consensus

; --- 1. RISK & MONEY MANAGEMENT ---
InpRiskPercent=2.0
InpMaxSpreadPips=5.0
InpMinATRPips=0.0       ; Disabled to allow all volatility states

; --- 2. MARKET BIAS (The Engine) ---
InpBiasEnabled=true
InpBiasMode=1           ; 1 = BIAS_AUTO
InpManualSide=0         ; 0 = SIDE_BOTH
InpAutoStrat=1          ; 1 = STRAT_PAIR_CROSS (Classic MA Cross logic)
InpBiasFast=2           ; 2 = ROLE_EMA3 (Period 34)
InpBiasSlow=3           ; 3 = ROLE_EMA4 (Period 55)

; --- 3. FILTERS (Disable "Committee" to reduce latency) ---
InpUseTimeFilter=false  ; OFF - Trade 24/5 like the Standard EA
InpStartHour=0
InpEndHour=0
InpUseNewsFilter=false  ; OFF - Don't fear volatility, ride it
InpNewsFileName=calendar_statement.csv
InpNewsPreMin=60
InpNewsPostMin=60

; --- 4. HTF CONTEXT ---
InpUseHTF_Filter=false  ; OFF - Don't wait for H4 confirmation on H1 trades

; --- 5. CONFLUENCE VOTING (Aggressive) ---
InpVotingThreshold=1    ; ONLY 1 VOTE REQUIRED (Bias + 1 Signal = GO)

; --- 6. INDICATOR SETTINGS ---
InpEma1Period=12        ; Fast reaction
InpEma2Period=26
InpEma3Period=34        ; Trend Definition Fast
InpEma4Period=55        ; Trend Definition Slow

; --- ACTIVE VOTES (The "Sniper" Team) ---
InpUseEmaSignal=true    ; Vote 1: Recovery (Price > EMA)
InpUseAdx=true          ; Vote 2: Trend Strength
InpAdxPeriod=14
InpAdxThreshold=20
InpUseMacd=true         ; Vote 3: Momentum
InpMacdMode=0           ; SIGNAL_ALIGN
InpMacdFast=12
InpMacdSlow=26
InpMacdSig=9

; --- DISABLED VOTES (Noise Reduction) ---
InpUseRsi=false         ; OFF - Too restrictive in strong trends
InpUseCci=false         ; OFF
InpUseMfi=false         ; OFF
InpUseSto=false         ; OFF
InpUseBB=false          ; OFF

; --- PRICE ACTION TRIGGERS ---
InpUsePsar=true         ; Vote 4: Trailing support
InpPsarStep=0.02
InpPsarMax=0.2
InpUsePattern123=false
InpUseRossHook=true     ; Vote 5: Breakout Confirmation (High Quality)

; --- 7. EXIT & BREAKEVEN (The Safety Net) ---
InpSLMultiplier=3.0     ; Wide SL to breathe (Standard EA doesn't use tight SL)
InpTPMultiplier=6.0     ; Big targets
InpUseBreakeven=true    ; ON - "Free Ride" mode
InpBE_TriggerATR=1.5    ; Lock profit after 1.5 ATR move
InpBE_BufferATR=0.2     ; Lock at Entry + 0.2 ATR
InpTrailMode=1          ; 1 = TRAIL_ATR
InpTrailATRMult=2.0     ; Trailing distance
InpExportCSV=true       ; Keep reporting ON