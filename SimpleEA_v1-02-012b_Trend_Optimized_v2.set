; SimpleEA v1.02.012 Optimized Trend Preset
; Strategy: Aggressive Trend Following (Replicating Standard MA EA aggression)
; -------------------------------------------

; === 1. RISK & MONEY MANAGEMENT ===
InpRiskPercent=2.0
InpMaxSpreadPips=5.0
InpMinATRPips=0.0       ; Disabled (0.0) to allow trading in all volatility conditions

; === 2. MARKET BIAS ===
InpBiasEnabled=true
InpBiasMode=1           ; 1 = BIAS_AUTO
InpManualSide=0         ; 0 = SIDE_BOTH
InpAutoStrat=1          ; 1 = STRAT_PAIR_CROSS (Classic Fast/Slow MA Cross)
InpBiasFast=2           ; 2 = ROLE_EMA3 (Period 34)
InpBiasSlow=3           ; 3 = ROLE_EMA4 (Period 55)

; === 3. FILTERS ===
InpUseTimeFilter=false  ; OFF - Trade 24/5 to capture all moves
InpStartHour=8
InpEndHour=20
InpUseNewsFilter=false  ; OFF - Don't filter news for this aggressive test
InpNewsFileName=calendar_statement.csv
InpNewsPreMin=60
InpNewsPostMin=60

; === 4. REPORTING & HTF ===
InpExportCSV=true       ; Keep reporting ON
InpUseHTF_Filter=false  ; OFF - Do not wait for H4 confirmation (Too slow)
InpHTF_Period=16386     ; PERIOD_H4
InpHTF_EmaPeriod=55

; === 5. CONFLUENCE VOTING ===
InpVotingThreshold=1    ; AGGRESSIVE: Bias + 1 Indicator is enough to enter

; === 6. INDICATOR SETTINGS ===
InpEma1Period=12        ; Fast MA (Signal)
InpEma2Period=21
InpEma3Period=34        ; Trend Definition Fast
InpEma4Period=55        ; Trend Definition Slow

; --- ACTIVE VOTES (The "Sniper" Team) ---
InpUseEmaSignal=true    ; Vote 1: Recovery (Price > EMA12)
InpUseAdx=true          ; Vote 2: Trend Strength
InpAdxPeriod=14
InpAdxThreshold=20
InpUsePsar=true         ; Vote 3: Trend Direction
InpPsarStep=0.02
InpPsarMax=0.2
InpUseMacd=true         ; Vote 4: Momentum Align
InpMacdMode=0           ; 0 = MACD_SIGNAL_ALIGN
InpMacdFast=12
InpMacdSlow=26
InpMacdSig=9
InpUseRossHook=true     ; Vote 5: Breakout Pattern

; --- DISABLED VOTES (Noise Reduction) ---
InpUseRsi=false
InpRsiMode=0
InpRsiPeriod=14
InpRsiOverbought=70.0
InpRsiOversold=30.0
InpUseCci=false
InpCciMode=0
InpCciPeriod=14
InpUseMfi=false
InpMfiPeriod=14
InpMfiLevel=50.0
InpUseSto=false
InpStoMode=0
InpStoK=5
InpStoD=3
InpStoSlow=3
InpUseBB=false
InpBbMode=0
InpBbPeriod=20
InpBbDev=2.0
InpUsePattern123=false

; === 7. EXIT & BREAKEVEN ===
InpSLMultiplier=3.0     ; Wide SL to allow market "breathing"
InpTPMultiplier=6.0     ; Big targets for trend riding
InpUseBreakeven=true    ; ON - "Free Ride" mode
InpBE_TriggerATR=1.5    ; Lock profit after 1.5 ATR move
InpBE_BufferATR=0.2     ; Lock at Entry + 0.2 ATR
InpTrailMode=1          ; 1 = TRAIL_ATR
InpTrailATRMult=2.0     ; Trailing distance