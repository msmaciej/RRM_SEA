-// F-AUDIT 2026-06: news impact filter — user picks which severity levels block trades.
-// Default NEWS_IMPACT_MED_PLUS matches the prior hardcoded behavior of NewsImpactPass
-// (low impact ignored, medium/high blocks). Empty impact strings always count as
-// "relevant" (treated as MED+) to preserve safety for unparsed news feeds.
+// NEWS-AUDIT 2026-07: news impact filter — user picks which severity levels block trades.
+// Levels map directly onto MT5's native ENUM_CALENDAR_EVENT_IMPORTANCE, which is an
+// ordered enum: NONE(0) < LOW(1) < MODERATE(2) < HIGH(3). There is no longer any
+// string parsing (the CSV feed and its "unparsed impact = block for safety" fallback
+// were removed) — importance is read from MqlCalendarEvent.importance and is either
+// present or the event is not stored at all.
 enum ENewsImpactLevel
 {
-   NEWS_IMPACT_ALL,        // ALL: every news event blocks (incl. low impact)
-   NEWS_IMPACT_MED_PLUS,   // MED+: medium and high impact block (default; legacy behavior)
-   NEWS_IMPACT_HIGH_ONLY   // HIGH: only high impact blocks
+   NEWS_IMPACT_ALL,        // ALL: every calendar event blocks (incl. LOW and NONE)
+   NEWS_IMPACT_MED_PLUS,   // MED+: MODERATE and HIGH block (legacy default)
+   NEWS_IMPACT_HIGH_ONLY   // HIGH: only HIGH blocks (RRM_ORG live-test target)
 };
 // Trading hours filter — broker time defaults (EET = UTC+2/+3 DST typical):
 //   London: 09:00–17:00   NY: 14:00–22:00   Asia/Tokyo: 01:00–09:00
@@ -339,11 +341,21 @@ struct SGateConfig
    EGateScaleMode mode;
    double         value;   // Fixed pips or TF scaling factor
 };
+// NEWS-AUDIT 2026-07: sourced from MT5's native economic calendar, never a file.
+//   time       — MqlCalendarValue.time, already in BROKER SERVER time (same clock as
+//                TimeCurrent()). No offset arithmetic is applied anywhere, by design:
+//                every timezone/DST conversion is a defect waiting to happen.
+//   currency   — known by construction: events are queried per-currency via
+//                CalendarValueHistory(..., currency), because MqlCalendarEvent carries
+//                no currency field (it links to a country, which owns the currency).
+//   importance — MqlCalendarEvent.importance (ENUM_CALENDAR_EVENT_IMPORTANCE).
+//   name       — event name, logged so the operator can verify the blackout anchor.
 struct SNewsEvent
 {
    datetime time;
    string   currency;
-   string   impact;
+   int      importance;   // ENUM_CALENDAR_EVENT_IMPORTANCE: NONE 0 / LOW 1 / MODERATE 2 / HIGH 3
+   string   name;
 };
