# rrm_meta.config — sits next to rrm_meta.py. Edit ONCE (optional).
#
# The script AUTO-LOCATES both CSVs under your MT5/Wine tree, so files_dir can
# stay blank. The EA writes the events file with FILE_COMMON, which lands in
#   <terminal>\Common\Files\TS_events_<PRESET>.csv
# NOT in the Tester agent sandbox — leave files_dir blank and let it search, or
# set it explicitly to override.

[meta]
# Optional. Blank = auto-search Common\Files, Tester\Agent-*\MQL5\Files, MQL5\Files.
files_dir =

pair   = GBPUSD
tf     = M15
preset = RRM_ORG
