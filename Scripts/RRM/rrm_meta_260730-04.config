# rrm_meta.config — sits next to rrm_meta.py. Edit ONCE.
# These become the defaults; the script still lets you press Enter to accept
# them or type a new value at each prompt. CLI flags override everything.

[meta]
# Full path to MT5's shared Common\Files folder under macOS + Wine.
# Find it in MT5: File > Open Data Folder, then go up into  Common\Files
files_dir = /Users/CHANGE_ME/.wine/drive_c/users/CHANGE_ME/AppData/Roaming/MetaQuotes/Terminal/Common/Files

# Defaults for the price-data file name  PAIR_TF_FROM_TO.csv
pair   = USDJPY
tf     = M15
from   = 240101
to     = 241231

# Which preset's signals to train on (must match Inp_META_PresetName in the EA)
preset = RRM_ORG
