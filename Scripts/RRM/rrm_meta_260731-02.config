# rrm_meta.config — sits next to rrm_meta.py.
#
# Files are now keyed by preset + PAIR + TIMEFRAME, so the EA on a EURUSD M1 chart
# writes/reads  TS_events_RRM_ORG_EURUSD_M1.csv  and  MetaModel_RRM_ORG_EURUSD_M1.csv .
#
# This trainer AUTO-DISCOVERS every  TS_events_<preset>*.csv  it can find and trains
# one model per pair+TF in a single run — collect all six pairs, then run this once.
# It writes each model to BOTH the agent sandbox and the terminal MQL5\Files (the
# folder the tester loads at GATE startup).
#
# files_dir can stay blank (auto-search). pair/tf below are only a fallback for a
# legacy unkeyed events file; per-pair files carry their own pair+TF in the name.
# To train just one pair:  python3 rrm_meta.py --pair EURUSD --tf M1

[meta]
files_dir =
pair   = GBPUSD
tf     = M15
preset = RRM_ORG
